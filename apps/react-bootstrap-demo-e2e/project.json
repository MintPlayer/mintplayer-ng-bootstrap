{
  "name": "react-bootstrap-demo-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/react-bootstrap-demo-e2e/src",
  "tags": [],
  "implicitDependencies": ["react-bootstrap-demo"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/react-bootstrap-demo-e2e"
      ]
    },
    "e2e-a11y": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.a11y.config.ts",
        "cwd": "apps/react-bootstrap-demo-e2e"
      }
    }
  }
}
