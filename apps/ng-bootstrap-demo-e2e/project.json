{
  "name": "ng-bootstrap-demo-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ng-bootstrap-demo-e2e",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["ng-bootstrap-demo"],
  "targets": {
    "e2e-live": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.live-api.config.ts",
        "cwd": "apps/ng-bootstrap-demo-e2e"
      }
    },
    "e2e-a11y": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.a11y.config.ts",
        "cwd": "apps/ng-bootstrap-demo-e2e"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
