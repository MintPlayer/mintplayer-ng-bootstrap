{
  "name": "mintplayer-ui-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer-ui-core/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/**/*.scoped.styles.ts",
        "{projectRoot}/styles/bootstrap.css",
        "{projectRoot}/phone-core/src/metadata-loaders.generated.ts",
        "{projectRoot}/phone-core/src/metadata/*.generated.ts"
      ],
      "inputs": [
        "{projectRoot}/**/*.scss",
        "{workspaceRoot}/tools/scripts/build-web-components.mjs",
        "{workspaceRoot}/tools/scripts/lib/*.mjs",
        "{workspaceRoot}/tools/scripts/build-phone-metadata.mjs",
        {
          "externalDependencies": [
            "libphonenumber-js"
          ]
        }
      ],
      "cache": true,
      "options": {
        "parallel": false,
        "commands": [
          "node tools/scripts/build-web-components.mjs libs/mintplayer-ui-core",
          "node tools/scripts/build-phone-metadata.mjs"
        ]
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "dependsOn": [
        "codegen"
      ],
      "options": {
        "outputPath": "dist/libs/mintplayer-ui-core"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": [
        "codegen"
      ],
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/libs/mintplayer-ui-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
