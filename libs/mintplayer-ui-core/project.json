{
  "name": "mintplayer-ui-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer-ui-core/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/**/*.scoped.styles.ts"],
      "inputs": [
        "{projectRoot}/**/*.scss",
        "{workspaceRoot}/libs/mintplayer-ng-bootstrap/_bootstrap.scss",
        "{workspaceRoot}/tools/scripts/build-web-components.mjs",
        "{workspaceRoot}/tools/scripts/lib/*.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/scripts/build-web-components.mjs libs/mintplayer-ui-core"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["codegen"],
      "options": {
        "outputPath": "dist/libs/mintplayer-ui-core"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["codegen"],
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/mintplayer-ui-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
