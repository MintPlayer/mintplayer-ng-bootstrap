{
  "name": "mintplayer-ui-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer-ui-core/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/**/*.scoped.styles.ts",
        "{projectRoot}/**/*.bootstrap.styles.ts",
        "{projectRoot}/styles/bootstrap.css",
        "{projectRoot}/phone-core/src/metadata-loaders.generated.ts",
        "{projectRoot}/phone-core/src/metadata/*.generated.ts",
        "{projectRoot}/code-snippet/src/hljs-loaders.generated.ts",
        "{projectRoot}/flags/src/flag-loaders.generated.ts",
        "{projectRoot}/flags/src/all-flags.generated.ts"
      ],
      "inputs": [
        "{projectRoot}/**/*.scss",
        "{workspaceRoot}/tools/scripts/build-web-components.mjs",
        "{workspaceRoot}/tools/scripts/lib/*.mjs",
        "{workspaceRoot}/tools/scripts/build-phone-metadata.mjs",
        "{workspaceRoot}/tools/scripts/build-hljs-loaders.mjs",
        "{projectRoot}/flags/src/assets/*.svg",
        "{workspaceRoot}/tools/scripts/build-flag-loaders.mjs",
        {
          "externalDependencies": [
            "libphonenumber-js",
            "highlight.js"
          ]
        }
      ],
      "cache": true,
      "options": {
        "parallel": false,
        "commands": [
          "node tools/scripts/build-web-components.mjs libs/mintplayer-ui-core",
          "node tools/scripts/build-phone-metadata.mjs",
          "node tools/scripts/build-hljs-loaders.mjs",
          "node tools/scripts/build-flag-loaders.mjs"
        ]
      },
      "dependsOn": [
        "compile-components"
      ]
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "dependsOn": [
        "codegen"
      ],
      "options": {
        "outputPath": "dist/libs/mintplayer-ui-core"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": [
        "codegen",
        "typecheck-views"
      ],
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/libs/mintplayer-ui-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck-views": {
      "dependsOn": [
        "codegen"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/views.d.ts",
        "{projectRoot}/**/*.view.vue",
        "{projectRoot}/**/*.ts",
        "!{projectRoot}/**/*.spec.ts",
        {
          "externalDependencies": [
            "vue-tsc",
            "vue"
          ]
        }
      ],
      "options": {
        "command": "vue-tsc --noEmit -p {projectRoot}/tsconfig.views.json"
      },
      "metadata": {
        "description": "Type-check the component compiler view templates as Vue (what an editor's Vue language service sees)."
      }
    }
  }
}
