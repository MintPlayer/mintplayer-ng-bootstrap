{
  "name": "@mintplayer/vue-bootstrap",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Vue 3.5 Bootstrap components. Each sub-entry renders its own template over a framework-neutral core from @mintplayer/ui-core, with v-model on every two-way input, so it server-renders real HTML and defines no custom elements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MintPlayer/mintplayer-ng-bootstrap",
    "directory": "libs/mintplayer-vue-bootstrap"
  },
  "author": {
    "name": "Pieterjan De Clippel",
    "url": "https://github.com/MintPlayer",
    "email": "info@mintplayer.com"
  },
  "type": "module",
  "sideEffects": [
    "**/src/index.{ts,js,mjs}",
    "**/Bs*.vue"
  ],
  "main": "./index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@mintplayer/ui-core": "^1.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
