{
  "name": "@mintplayer/react-bootstrap",
  "version": "0.0.0-PLACEHOLDER",
  "description": "React 19 Bootstrap components. Each sub-entry renders its own JSX over a framework-neutral core from @mintplayer/ui-core, so it server-renders real HTML and defines no custom elements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MintPlayer/mintplayer-ng-bootstrap",
    "directory": "libs/mintplayer-react-bootstrap"
  },
  "author": {
    "name": "Pieterjan De Clippel",
    "url": "https://github.com/MintPlayer",
    "email": "info@mintplayer.com"
  },
  "type": "module",
  "sideEffects": [
    "**/src/index.{ts,js,mjs,tsx,jsx}",
    "**/Bs*.{mjs,js,tsx,jsx}"
  ],
  "main": "./index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@mintplayer/ui-core": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
