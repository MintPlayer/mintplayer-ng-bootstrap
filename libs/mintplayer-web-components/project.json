{
  "name": "mintplayer-web-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer-web-components/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "codegen-wc": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/**/*.element.template.ts",
        "{projectRoot}/**/*.styles.ts",
        "{projectRoot}/flags/src/flag-loaders.generated.ts",
        "{projectRoot}/flags/src/all-flags.generated.ts",
        "{projectRoot}/phone-core/src/metadata-loaders.generated.ts",
        "{projectRoot}/phone-core/src/metadata/*.generated.ts",
        "{projectRoot}/code-snippet/src/hljs-loaders.generated.ts"
      ],
      "inputs": [
        "{projectRoot}/**/*.element.html",
        "{projectRoot}/**/*.element.scss",
        "{projectRoot}/**/*.styles.scss",
        "{projectRoot}/**/*.light.scss",
        "{projectRoot}/flags/src/assets/*.svg",
        "{workspaceRoot}/tools/scripts/build-web-components.mjs",
        "{workspaceRoot}/tools/scripts/lib/wc-codegen.mjs",
        "{workspaceRoot}/tools/scripts/lib/rescope-css.mjs",
        "{workspaceRoot}/tools/scripts/build-flag-loaders.mjs",
        "{workspaceRoot}/tools/scripts/build-phone-metadata.mjs",
        "{workspaceRoot}/tools/scripts/build-hljs-loaders.mjs",
        {
          "externalDependencies": ["libphonenumber-js", "highlight.js"]
        }
      ],
      "cache": true,
      "options": {
        "parallel": false,
        "commands": [
          "node tools/scripts/build-web-components.mjs libs/mintplayer-web-components",
          "node tools/scripts/build-flag-loaders.mjs",
          "node tools/scripts/build-phone-metadata.mjs",
          "node tools/scripts/build-hljs-loaders.mjs"
        ]
      }
    },
    "codegen-wc-watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "node tools/scripts/build-web-components.mjs libs/mintplayer-ng-bootstrap libs/mintplayer-web-components --watch"
      }
    },
    "cem": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/custom-elements.json"],
      "inputs": [
        "{projectRoot}/**/*.element.ts",
        "{projectRoot}/**/src/**/*.ts",
        "!{projectRoot}/**/*.spec.ts",
        "!{projectRoot}/**/*.element.template.ts",
        "{projectRoot}/custom-elements-manifest.config.mjs"
      ],
      "cache": true,
      "options": {
        "cwd": "libs/mintplayer-web-components",
        "command": "custom-elements-manifest analyze --litelement"
      }
    },
    "codegen-shell-chrome": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/shell/ssr/mp-shell-chrome.generated.ts"],
      "inputs": [
        "{projectRoot}/shell/src/components/mp-shell.ts",
        "{projectRoot}/shell/src/styles/shell.styles.scss",
        "{workspaceRoot}/tools/lit-ssr-utils/gen-shell-chrome.mjs"
      ],
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "command": "node tools/lit-ssr-utils/gen-shell-chrome.mjs"
      }
    },
    "codegen-dropdown-chrome": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dropdown-menu/ssr/mp-dropdown-chrome.generated.ts"
      ],
      "inputs": [
        "{projectRoot}/dropdown-menu/src/components/*.ts",
        "{projectRoot}/dropdown-menu/src/styles/*.styles.scss",
        "{workspaceRoot}/tools/lit-ssr-utils/gen-dropdown-chrome.mjs"
      ],
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "command": "node tools/lit-ssr-utils/gen-dropdown-chrome.mjs"
      }
    },
    "codegen-navbar-chrome": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/navbar/ssr/mp-navbar-chrome.generated.ts"],
      "inputs": [
        "{projectRoot}/navbar/src/components/*.ts",
        "{projectRoot}/navbar/src/styles/*.styles.scss",
        "{workspaceRoot}/tools/lit-ssr-utils/gen-navbar-chrome.mjs"
      ],
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "command": "node tools/lit-ssr-utils/gen-navbar-chrome.mjs"
      }
    },
    "codegen-carousel-chrome": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/carousel/ssr/mp-carousel-chrome.generated.ts"],
      "inputs": [
        "{projectRoot}/carousel/src/components/*.ts",
        "{projectRoot}/carousel/src/styles/*.styles.scss",
        "{workspaceRoot}/tools/lit-ssr-utils/gen-carousel-chrome.mjs"
      ],
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "command": "node tools/lit-ssr-utils/gen-carousel-chrome.mjs"
      }
    },
    "codegen-accordion-chrome": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/accordion/ssr/mp-accordion-chrome.generated.ts"
      ],
      "inputs": [
        "{projectRoot}/accordion/src/components/*.ts",
        "{projectRoot}/accordion/src/styles/*.styles.scss",
        "{workspaceRoot}/tools/lit-ssr-utils/gen-accordion-chrome.mjs"
      ],
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "command": "node tools/lit-ssr-utils/gen-accordion-chrome.mjs"
      }
    },
    "codegen-ssr-chrome": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"SSR DSD chrome generated (shell + navbar + dropdown + carousel + accordion)\""
      },
      "dependsOn": [
        "codegen-shell-chrome",
        "codegen-navbar-chrome",
        "codegen-dropdown-chrome",
        "codegen-carousel-chrome",
        "codegen-accordion-chrome"
      ]
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["codegen-wc", "cem"],
      "options": {
        "outputPath": "dist/libs/mintplayer-web-components"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/mintplayer-web-components"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
