{
  "name": "mintplayer-web-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer-web-components/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "codegen-wc": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/**/*.element.template.ts",
        "{projectRoot}/**/*.styles.ts",
        "{projectRoot}/theming/bs-theme-preboot.js"
      ],
      "inputs": [
        "{projectRoot}/**/*.element.html",
        "{projectRoot}/**/*.element.scss",
        "{projectRoot}/**/*.styles.scss",
        "{projectRoot}/**/*.light.scss",
        "{workspaceRoot}/tools/scripts/build-web-components.mjs",
        "{workspaceRoot}/tools/scripts/lib/wc-codegen.mjs",
        "{workspaceRoot}/tools/scripts/lib/rescope-css.mjs",
        "{projectRoot}/theming/src/**/*.ts",
        "{workspaceRoot}/libs/mintplayer-ui-core/theming/src/**/*.ts",
        "{workspaceRoot}/tools/scripts/build-theme-preboot.mjs",
        "{workspaceRoot}/tools/scripts/lib/cli.mjs"
      ],
      "cache": true,
      "options": {
        "parallel": false,
        "commands": [
          "node tools/scripts/build-web-components.mjs libs/mintplayer-web-components",
          "node tools/scripts/build-theme-preboot.mjs"
        ]
      }
    },
    "codegen-wc-watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "commands": [
          "node --watch-path=libs/mintplayer-ui-core/theming/src tools/scripts/build-theme-preboot.mjs",
          "node tools/scripts/build-web-components.mjs libs/mintplayer-ng-bootstrap libs/mintplayer-web-components --watch"
        ],
        "parallel": true
      }
    },
    "cem": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["mintplayer-ui-core"],
          "target": "codegen"
        }
      ],
      "outputs": [
        "{projectRoot}/custom-elements.json"
      ],
      "inputs": [
        "{projectRoot}/**/*.element.ts",
        "{projectRoot}/**/src/**/*.ts",
        "!{projectRoot}/**/*.spec.ts",
        "!{projectRoot}/**/*.element.template.ts",
        "{projectRoot}/custom-elements-manifest.config.mjs"
      ],
      "cache": true,
      "options": {
        "cwd": "libs/mintplayer-web-components",
        "command": "custom-elements-manifest analyze --litelement"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "dependsOn": [
        "codegen-wc",
        "cem",
        {
          "projects": [
            "mintplayer-ui-core"
          ],
          "target": "codegen"
        }
      ],
      "options": {
        "outputPath": "dist/libs/mintplayer-web-components"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": [
        "codegen-wc",
        "cem",
        "build",
        {
          "projects": [
            "mintplayer-ui-core"
          ],
          "target": "codegen"
        }
      ],
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/libs/mintplayer-web-components"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
